# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Compiled Go binaries. `go build` drops an extensionless file named after the package into
# cwd — tools/apidocs/apidocs was committed at 51 MB this way. Ignore every lowercase
# extensionless name, then re-include directories, dotted files, and the extensionless
# sources we actually track. Later rules still deny .env, *.exe, bin/, and the rest.
[a-z0-9_-]*
!*/
!*.*
!Makefile
!Dockerfile
!LICENSE
!Tiltfile
!tools/tool-versions
!.claude/skills/mysql

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
.gocache/
go.work
go.work.sum

# env file
.env
.env.e2e

# Editor/IDE
.idea/
# .vscode/

tmp/
bin/
test/logs/

# cursor
# .cursor/

# all .DS_STORE files
*.DS_STORE

# generated openapi spec docs
specs/
httpie/
vacuum-spectral-report.json

# Added by goreleaser init:
dist/

# build files
build/

# kubernetes secrets
secrets.yaml

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
override.tf
override.tf.json
_override.tf
_override.tf.json
.terraformrc
terraform.rc
crash.log

# cache
.cache/

# builds
stainless/internal/builds/
stainless/public/builds/

# prompt executables
prompts/*.mjs

# Agent worktrees. `git worktree add` under .claude/ leaves a directory whose own .git makes it look
# like a submodule, so `git add .` records it as a gitlink — a commit pointer with no .gitmodules
# entry behind it, which every other clone fails to resolve. They are scratch checkouts of this same
# repo and belong to whoever created them.
.claude/worktrees/
