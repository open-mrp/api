{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.go": "${capture}_test.go"
  },
  "[json]": {
    "editor.tabSize": 4
  },
  "[yaml]": {
    "editor.tabSize": 4
  },
  "[go]": {
    "editor.wordWrap": "on"
  },
  "gopls": {
    "buildFlags": ["-tags=e2e"]
  },
}
